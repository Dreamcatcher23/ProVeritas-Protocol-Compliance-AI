# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
DOCUMENTS_BUCKET=your-s3-bucket-name-here

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production-use-random-string
FLASK_ENV=development

# Note: Generate a secure SECRET_KEY for production using:
# python -c "import secrets; print(secrets.token_hex(32))"

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to Git (it's in .gitignore)
